{
  "name": "@simplecut/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SimpleCut — a beginner-friendly video editor for YouTube",
  "author": "SimpleCut",
  "main": "out/main/index.js",
  "scripts": {
    "prepare-bin": "node scripts/prepare-bin.mjs",
    "dev": "node scripts/prepare-bin.mjs && electron-vite dev",
    "build": "node scripts/prepare-bin.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "node scripts/prepare-bin.mjs && electron-vite build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/prepare-bin.mjs && vitest run",
    "e2e": "node scripts/prepare-bin.mjs && electron-vite build && node e2e/smoke.mjs && node e2e/extras.mjs && node e2e/phase2.mjs && node e2e/phase3.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@simplecut/core": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "lucide-react": "1.57.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  }
}
